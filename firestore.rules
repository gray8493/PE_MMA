rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function requiredText(value, maxLen) {
      return value is string && value.trim().size() > 0 && value.size() <= maxLen;
    }

    // Absent and null both mean "no rating".
    function validRating(data) {
      return !('rating' in data) || data.rating == null
        || (data.rating is int && data.rating >= 0 && data.rating <= 5);
    }

    function validNotes(data) {
      return !('notes' in data) || data.notes == null
        || (data.notes is string && data.notes.size() <= 300);
    }

    function validFavorite(data) {
      return !('favorite' in data) || data.favorite is bool;
    }

    // Must match movieKeyPart() in src/lib/movies.ts.
    function keyPart(value) {
      return value.trim().lower()
        .replace('%', '%25')
        .replace('/', '%2F')
        .replace('[|]', '%7C');
    }

    // Rules cannot query other rows, so uniqueness comes from the document id:
    // one user + title + director (ignoring case) maps to exactly one document.
    function canonicalId(data) {
      return request.auth.uid + '|' + keyPart(data.title) + '|' + keyPart(data.director);
    }

    function validMovie(movieId) {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'director', 'genre', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'director', 'genre', 'status',
                                'rating', 'favorite', 'notes', 'createdAt'])
        && data.userId == request.auth.uid
        && requiredText(data.title, 100)
        && requiredText(data.director, 60)
        && data.genre in ['Action', 'Comedy', 'Drama', 'Horror']
        && data.status in ['Plan to Watch', 'Watching', 'Watched']
        && validRating(data)
        && validFavorite(data)
        && validNotes(data)
        && data.createdAt is timestamp
        && (!('id' in data) || data.id == movieId)
        && movieId == canonicalId(data);
    }

    match /movies/{movieId} {
      allow read: if owns(resource.data);

      allow create: if owns(request.resource.data) && validMovie(movieId);

      // createdAt never changes, so saving a duplicate over an existing movie
      // (which Firestore sees as an update) is refused.
      allow update: if owns(resource.data)
        && owns(request.resource.data)
        && validMovie(movieId)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if owns(resource.data);
    }

    // Everything else: nothing for anyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
